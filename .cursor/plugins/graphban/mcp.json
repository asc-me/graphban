{
  "mcpServers": {
    "graphban-planner": {
      "url": "http://localhost:8000/api/mcp",
      "headers": {
        "X-API-Key": "${env:GRAPHBAN_PLANNER_KEY}"
      }
    },
    "graphban-worker": {
      "url": "http://localhost:8000/api/mcp",
      "headers": {
        "X-API-Key": "${env:GRAPHBAN_WORKER_KEY}"
      }
    },
    "graphban-reviewer": {
      "url": "http://localhost:8000/api/mcp",
      "headers": {
        "X-API-Key": "${env:GRAPHBAN_REVIEWER_KEY}"
      }
    }
  }
}
