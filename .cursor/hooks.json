{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "python3 .cursor/hooks/gb_session_start.py"
      }
    ],
    "afterFileEdit": [
      {
        "type": "command",
        "command": "python3 .cursor/hooks/gb_after_file_edit.py"
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "python3 .cursor/hooks/gb_stop.py",
        "loop_limit": 1
      }
    ],
    "afterMCPExecution": [
      {
        "type": "command",
        "command": "python3 .cursor/hooks/gb_claim_manifest.py"
      }
    ]
  }
}
