# Rendered by the nginx image's envsubst entrypoint at container start: ${PORT} and
# ${API_UPSTREAM} come from the environment (AL-27). Defaults (set in the Dockerfile)
# keep docker-compose working — PORT=80, API_UPSTREAM=api:8000 — while a managed host
# like Railway injects its own $PORT and the backend's internal address. NGINX_ENVSUBST_FILTER
# restricts substitution to those two names so nginx runtime vars ($host, $uri, …) survive.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers (AL-73). HSTS assumes TLS terminates at/above this edge.
    # frame-ancestors allows the roadmap embed to be iframed anywhere while blocking
    # the app itself from being framed elsewhere is intentionally NOT done here (the
    # embed route needs framing); clickjacking of the authed app is mitigated by the
    # SPA living on its own origin. nosniff + Referrer-Policy are unconditional.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "frame-ancestors 'self' https:" always;

    # RE-RESOLVE THE UPSTREAM ON EVERY REQUEST (GRPH-523). A `proxy_pass` holding a literal
    # is resolved ONCE at config load and the address is cached for the worker's life. That
    # took the site down on 2026-08-26: both services redeployed together, nginx pinned the
    # address of the backend container that was going away, and every proxied request hung
    # once it died — while Railway reported SUCCESS and its healthcheck on `/`, served by
    # nginx itself, stayed 200 throughout.
    #
    # Naming the upstream in a VARIABLE forces nginx to consult `resolver` per request
    # instead, so a redeployed backend is followed without restarting this container. The
    # resolver address comes from the image's own 15-local-resolvers.envsh (enabled by
    # NGINX_ENTRYPOINT_LOCAL_RESOLVERS in the Dockerfile), which reads /etc/resolv.conf —
    # so this works unchanged against Docker's embedded DNS and Railway's private DNS.
    #
    # `ipv6=off` is deliberate, not caution: uvicorn is started with `--host 0.0.0.0`,
    # which is IPv4-ONLY, so an AAAA answer would give nginx an address nothing is
    # listening on. Whoever changes that bind should change this in the same commit.
    #
    # `valid=10s` bounds how long a stale address can survive. Longer reopens the outage
    # in miniature; shorter buys little and pays a lookup per request.
    #
    # NOTE ON URI SEMANTICS: neither proxy_pass below carries a URI part (no trailing path),
    # so nginx forwards the original request URI unchanged — with a literal AND with a
    # variable. That equivalence is why this change is safe; a URI part on either form
    # would rewrite the path and silently change routing. `test_nginx_upstream.py` pins it.
    #
    # ${API_SCHEME}/${API_UPSTREAM} default to http/api:8000 for docker-compose; Railway
    # sets them to http/backend.railway.internal:8000 over the private network.
    # Host is set to the upstream so an edge router can route by it; SNI is sent for https.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass ${API_SCHEME}://$api_upstream;
        proxy_http_version 1.1;
        # MUST exceed fleet.MAX_WAIT_SECONDS (60). `claim_cluster(wait_seconds=60)` parks for
        # up to a minute by design, and nginx's DEFAULT proxy_read_timeout is also 60s — so a
        # full-length park and the proxy's cutoff were the same number, and the agent got a
        # 504 instead of its answer. Found on the PRD-17 walk by a real Cursor client, having
        # been predicted and never tested: every park until then ran against an injected clock.
        # The margin is deliberate; equal values are a coin flip, not a bound.
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_UPSTREAM};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass ${API_SCHEME}://$api_upstream;
        proxy_ssl_server_name on;
        proxy_set_header Host ${API_UPSTREAM};
    }

    # Vite content-hashes everything under /assets/ — the filename changes whenever the bytes
    # do — so these are safe to cache indefinitely.
    #
    # NOTE: `add_header` in a location REPLACES the inherited set rather than adding to it, so
    # the four security headers above are repeated in every block below that sets one. A test
    # asserts that, because dropping them here would be invisible.
    location /assets/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "frame-ancestors 'self' https:" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA fallback. index.html is the one UNHASHED file and it names the hashed bundle, so a
    # cached copy pins the browser to the previous deploy's JS indefinitely: the server has
    # moved on, the tab has not, and nothing tells either of them they disagree. version.txt
    # is the release identity and a stale one actively lies about what is running.
    location / {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "frame-ancestors 'self' https:" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
