FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install deps first for layer caching.
COPY pyproject.toml ./
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini
# Refusal coverage (GRPH-1192): publish it the way the packer does, so the image reports
# "N of M" instead of `published: false`. The build context is backend/, so the script is
# a byte-identical copy of scripts/refusal_ratchet.py (guarded by test_refusals.py); it
# scans `<root>/backend/app`, hence the symlinked layout. A failing ratchet fails the build.
COPY scripts/refusal_ratchet.py /opt/ratchet/scripts/refusal_ratchet.py
ARG GIT_SHA=unknown
RUN ln -s /app /opt/ratchet/backend \
    && python /opt/ratchet/scripts/refusal_ratchet.py publish /app/app/data/refusal_coverage.json "$GIT_SHA" \
    && test -s /app/app/data/refusal_coverage.json
# gban skills (GRPH-1194): the build context has no cli/, so the image ships the manifest
# checked in at backend/scripts/gban_skills.json — generated by
# `scripts/graphban_pack.py --skills-manifest` and held equal to cli/ by test_pack_release.py.
COPY scripts/gban_skills.json ./app/data/gban_skills.json
RUN test -s /app/app/data/gban_skills.json
RUN pip install --no-cache-dir .

# Release identity: passed at build time (see docs/deploy.md), surfaced by /health.
ARG GIT_SHA=unknown
ENV GIT_SHA=$GIT_SHA

EXPOSE 8000

# Honor $PORT so the same image serves docker-compose (defaults to 8000) and managed
# hosts like Railway (which inject $PORT). Shell form + healthcheck both read it (AL-26).
#
# `app.serve` rather than the `uvicorn` CLI, so logging is configured before uvicorn's first
# line. The CLI logs "Started server process" before the app's lifespan runs, which under
# LOG_JSON=true put two plain-text lines on a JSON stream — and they are the two an operator
# reads when a box will not boot (GRPH-33). It reads $PORT and $HOST itself.
HEALTHCHECK --interval=10s --timeout=3s --retries=10 \
    CMD python -c "import os,urllib.request,sys; p=os.environ.get('PORT','8000'); sys.exit(0 if urllib.request.urlopen(f'http://localhost:{p}/health').status==200 else 1)"

CMD ["python", "-m", "app.serve"]
